# Supabase/PostgreSQL
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: explicit local/demo fallback when Supabase is not configured.
# Do not use this to fake authentication for a production deployment.
NEXT_PUBLIC_SUSTAIN_X_DEMO_MODE=true

# AI provider configuration. Keep API keys server-side only.
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b
AI_VISION_MODEL=qwen/qwen3.6-27b
GROQ_API_KEY=
